CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# The default UART0 console uses GPIO16/GPIO17, which are the IMU interrupt lines on this
# board. Logging only over the native USB port keeps those pins free.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# WakeNet9s is the only wake word engine that fits and runs on the C6 without
# PSRAM. Select only Alexa so the packed model image stays small.
CONFIG_SR_WN_WN9S_ALEXA=y

# The status screen is four labels and a scrollable reply, so LVGL's own heap
# does not need the 64 KB default. Creating the screen uses about 7 KB; 16 KB
# leaves room for text and fragmentation. The 38.4 KB draw buffer is allocated
# separately by esp_lvgl_port from the DMA-capable heap, and the display still
# has to leave at least 60 KB free during MP3 playback.
CONFIG_LV_MEM_SIZE_KILOBYTES=16
# Only the two Montserrat sizes the screen uses are compiled in: 16 for the
# state and transcript, 14 for the reply. 14 is LVGL's default; listing both
# keeps the choice explicit and the other sizes out of flash.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y

# The reply player only ever sees MP3 and 16-bit PCM WAV. esp_audio_codec turns
# every decoder, container parser and encoder on by default, which would link
# codecs the firmware never calls and spend flash on them; these are the only
# two paths the player needs.
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_PCM_SUPPORT=y
# CONFIG_AUDIO_DECODER_AAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_G711_SUPPORT is not set
# CONFIG_AUDIO_DECODER_AMRNB_SUPPORT is not set
# CONFIG_AUDIO_DECODER_AMRWB_SUPPORT is not set
# CONFIG_AUDIO_DECODER_FLAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_OPUS_SUPPORT is not set
# CONFIG_AUDIO_DECODER_VORBIS_SUPPORT is not set
# CONFIG_AUDIO_DECODER_ADPCM_SUPPORT is not set
# CONFIG_AUDIO_DECODER_ALAC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_SBC_SUPPORT is not set
# CONFIG_AUDIO_DECODER_LC3_SUPPORT is not set
# CONFIG_AUDIO_DECODER_G722_SUPPORT is not set
CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=y
# CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT is not set
# CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_AAC_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_G711_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_AMRNB_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_AMRWB_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_OPUS_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_ADPCM_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_ALAC_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_PCM_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_SBC_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_LC3_SUPPORT is not set
# CONFIG_AUDIO_ENCODER_G722_SUPPORT is not set
